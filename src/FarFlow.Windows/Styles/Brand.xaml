<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="PaperBrush" Color="#F4F1EA" />
      <SolidColorBrush x:Key="InkBrush" Color="#292D2A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#62675F" />
      <SolidColorBrush x:Key="RuleBrush" Color="#DCDDD3" />
      <SolidColorBrush x:Key="OliveBrush" Color="#53634C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="PaperBrush" Color="#222623" />
      <SolidColorBrush x:Key="InkBrush" Color="#F4F1EA" />
      <SolidColorBrush x:Key="MutedBrush" Color="#B7BDB3" />
      <SolidColorBrush x:Key="RuleBrush" Color="#434B43" />
      <SolidColorBrush x:Key="OliveBrush" Color="#B2C5A7" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="PaperBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="RuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="OliveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="BrandFont">ms-appx:///Assets/ZalandoSans.ttf#Zalando Sans</FontFamily>
  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" /><Setter Property="CharacterSpacing" Value="180" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
  </Style>
</ResourceDictionary>
