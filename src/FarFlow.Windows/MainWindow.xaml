<Window x:Class="FarFlow_Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Far Flow · Windows Preview">
 <Grid x:Name="Root" Background="{ThemeResource PaperBrush}" RequestedTheme="Light">
  <NavigationView x:Name="Navigation" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" OpenPaneLength="214" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1000" SelectionChanged="Navigation_SelectionChanged" Background="{ThemeResource PaperBrush}">
   <NavigationView.PaneHeader>
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="18,26,0,28">
     <Image Source="Assets/far-flow-icon.png" Width="40" Height="40" AutomationProperties.Name="Far Flow logo" />
     <StackPanel VerticalAlignment="Center"><TextBlock Text="far flow" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" /><TextBlock Text="WINDOWS / PREVIEW" Style="{StaticResource Eyebrow}" FontSize="8" /></StackPanel>
    </StackPanel>
   </NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Dictation" Tag="dictation" Icon="Microphone" IsSelected="True" />
    <NavigationViewItem Content="Local model" Tag="model" Icon="Download" />
    <NavigationViewItem Content="Testing guide" Tag="guide" Icon="Help" />
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter><StackPanel Margin="22,16,16,24" Spacing="8"><TextBlock Text="QUIETLY YOURS." Style="{StaticResource Eyebrow}" FontSize="9" /><TextBlock Text="On your PC. In your language." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="0.1.0 · Phase 1" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></StackPanel></NavigationView.PaneFooter>
   <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,26,28,28">
    <StackPanel MaxWidth="1100" Spacing="22">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="5"><TextBlock x:Name="PageLabel" Text="YOUR DAILY PRACTICE" Style="{StaticResource Eyebrow}" /><TextBlock x:Name="PageTitle" Text="Room for your thoughts." FontFamily="{StaticResource BrandFont}" FontSize="32" Foreground="{ThemeResource InkBrush}" TextWrapping="Wrap" /></StackPanel>
      <ComboBox Grid.Column="1" x:Name="ThemeChoice" Width="100" SelectedIndex="0" SelectionChanged="Theme_Changed" VerticalAlignment="Top" AutomationProperties.Name="Appearance"><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /><ComboBoxItem Content="System" /></ComboBox>
     </Grid>
     <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error" />
     <StackPanel x:Name="DictationPanel" Spacing="20">
      <Border CornerRadius="8" Height="190" Background="#E7DECB"><Image Source="Assets/travertine-banner.png" Stretch="UniformToFill" AutomationProperties.Name="Far Flow travertine wave artwork" /></Border>
      <StackPanel Spacing="7"><TextBlock Text="Speak naturally. Stay in flow." FontFamily="{StaticResource BrandFont}" FontSize="24" Foreground="{ThemeResource InkBrush}" /><TextBlock Text="English + Nederlands. Your voice stays on this PC." Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" /></StackPanel>
      <Border Height="1" Background="{ThemeResource RuleBrush}" />
      <StackPanel Spacing="12">
       <TextBlock x:Name="ReadyLabel" Text="○ MODEL NEEDED" Foreground="{ThemeResource OliveBrush}" Style="{StaticResource Eyebrow}" />
       <TextBlock x:Name="StatusText" Text="Open Local model to install your speech pack." FontSize="15" Foreground="{ThemeResource InkBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
       <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsOpen="False" IsDynamicOverflowEnabled="True">
        <AppBarButton x:Name="RecordButton" Icon="Microphone" Label="Record here" Click="Record_Click" IsEnabled="False" /><AppBarButton x:Name="CancelButton" Icon="Cancel" Label="Cancel" Click="Cancel_Click" IsEnabled="False" /><AppBarSeparator /><AppBarButton Icon="Copy" Label="Copy text" Click="Copy_Click" /><AppBarButton Icon="Delete" Label="Clear" Click="Clear_Click" />
       </CommandBar>
       <TextBox x:Name="Transcript" PlaceholderText="Your words will appear here." AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="230" AutomationProperties.Name="Latest local transcript" />
       <TextBlock x:Name="TimingText" Text="Transcripts stay in memory for this session. Audio is never saved." Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <Border Height="1" Background="{ThemeResource RuleBrush}" />
      <StackPanel Spacing="8"><TextBlock Text="A SMALL GESTURE. A CLEARER DAY." Style="{StaticResource Eyebrow}" /><TextBlock Text="Hold F8 to talk. Double-tap for hands-free. Press F8 again to finish, or Esc to cancel." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" FontSize="13" /><TextBlock Text="Direct insertion currently supports Notepad. Other apps use Copy text." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" FontSize="12" /></StackPanel>
     </StackPanel>
     <StackPanel x:Name="ModelPanel" Spacing="20" Visibility="Collapsed">
      <TextBlock Text="One download. Then offline." FontSize="25" Foreground="{ThemeResource InkBrush}" /><TextBlock Text="Parakeet v3 · English + Nederlands · CPU" Foreground="{ThemeResource OliveBrush}" />
      <TextBlock Text="Download the approved speech model once (670 MB). Far Flow verifies every file before loading it. Recording and transcription run on your PC, without an account or API key." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
      <StackPanel Spacing="10"><Button x:Name="DownloadButton" Content="Download local model" Click="Download_Click" HorizontalAlignment="Left" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LoadButton" Content="Load model" Click="Load_Click" /><Button x:Name="UnloadButton" Content="Unload" Click="Unload_Click" /></StackPanel></StackPanel>
      <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Visibility="Collapsed" /><TextBlock x:Name="ModelStatus" Text="No model loaded. No microphone is active." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
      <Button Content="Open model folder" Click="OpenModelFolder_Click" HorizontalAlignment="Left" />
      <TextBlock Text="Closing Far Flow stops its speech worker and unloads the model. Minimize keeps it available. The microphone is used only while recording." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
      <HyperlinkButton Content="Model credits and license" NavigateUri="https://github.com/Farazs27/far-flow-windows/blob/main/THIRD_PARTY_NOTICES.md" HorizontalAlignment="Left" />
     </StackPanel>
     <StackPanel x:Name="GuidePanel" Spacing="18" Visibility="Collapsed">
      <TextBlock Text="Your first Windows session." FontSize="25" Foreground="{ThemeResource InkBrush}" />
      <TextBlock Text="1. Open Local model and download the speech pack. Loading may take a moment on the first run." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
      <TextBlock Text="2. Allow desktop microphone access in Windows Settings. Select the correct input device there." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" /><Button Content="Open microphone privacy settings" Click="MicrophoneSettings_Click" HorizontalAlignment="Left" />
      <TextBlock Text="3. Open Notepad and click its document. Hold F8, speak, then release. Keep the cursor there until the text arrives. Try English, Dutch and mixed speech." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
      <TextBlock Text="4. Double-tap F8 for hands-free. Press once to finish. Esc cancels recording or processing." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
      <TextBlock Text="5. Disconnect the internet and repeat. Close Far Flow and check that FarFlow.ModelHost has disappeared from Task Manager." TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" />
      <TextBlock Text="F8 is reserved while this preview is open. Shortcut customization, broader app insertion, media pause/resume and the full Mac workspace are later phases." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" />
      <HyperlinkButton Content="Open the tester checklist" NavigateUri="https://github.com/Farazs27/far-flow-windows/blob/main/docs/TESTING-PREVIEW.md" HorizontalAlignment="Left" />
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
